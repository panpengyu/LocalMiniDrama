# =============================================================
# LocalMiniDrama 后端环境变量示例
# 用途：复制本文件为 .env 参考，并在部署环境（docker/k8s/系统服务）
#       中注入同名环境变量；后端直接读取 process.env，不依赖 dotenv。
# 优先级：环境变量 > configs/config.yaml > 代码内默认值
# 生产环境请优先使用环境变量注入敏感凭证，避免明文写入配置文件
# =============================================================

# JWT 签名密钥（强烈建议生产环境设置强随机串）
# 生成示例：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# 支付配置加密存储密钥（AES-256-GCM，对应 config.yaml app.secret）
APP_SECRET=

# 首次初始化 admin 账号的初始密码（部署后请立即登录并修改密码）
ADMIN_INIT_PASSWORD=

# MySQL 数据库连接（不设置则使用 configs/config.yaml 中 database 段的值）
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# 前端/外部服务
# API_PROXY_TARGET=   # Vite 开发服务器代理目标，默认 http://127.0.0.1:5679
# OPENAPI_BASE_URL=   # SDK（node/python）默认 API 基地址，默认 http://localhost:5679/api/v1/open
