{
  "name": "LocalMiniDrama-backend",
  "version": "1.5.0",
  "description": "Node.js backend for LocalMiniDrama",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "migrate:07": "node scripts/run-migration-07.js",
    "alert:scan": "node scripts/alert-scan.js",
    "alert:scan:verbose": "ANOMALY_LOG_LEVEL=debug node scripts/alert-scan.js",
    "alert:cron:install": "bash scripts/crontab-alert-scan.sh install",
    "alert:cron:uninstall": "bash scripts/crontab-alert-scan.sh uninstall",
    "alert:cron:status": "bash scripts/crontab-alert-scan.sh status",
    "test": "node --test test/*.test.js",
    "perf:test": "node scripts/loadtest/run-perf.js",
    "security:scan": "node test/security/security-scan.js",
    "seed:templates": "node scripts/seed-marketplace-templates.js",
    "test:coverage": "c8 --reporter=text --reporter=text-summary --exclude=test --exclude=migrations --exclude='scripts/*' --exclude='src/routes/*.test.js' node --test test/*.test.js",
    "test:coverage:html": "c8 --reporter=html --reporter=text-summary --exclude=test --exclude=migrations node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@volcengine/openapi": "^1.36.1",
    "adm-zip": "^0.5.16",
    "alipay-sdk": "^4.14.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.6.0",
    "bull": "^4.16.5",
    "c8": "^12.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "js-yaml": "^4.1.0",
    "jsonrepair": "^3.13.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.22.6",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "otplib": "^13.4.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "sync-mysql": "^3.0.1",
    "sync-sql": "^1.0.2",
    "uuid": "^10.0.0"
  }
}
